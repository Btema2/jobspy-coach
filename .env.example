APP_ENV=production
LOG_LEVEL=INFO
TIMEZONE=UTC
DB_PATH=data/jobs.db

# --- Primary LLM provider: NVIDIA NIM (enabled iff NVIDIA_API_KEY is set) ---
# Set to enable NIM (leave empty to disable).
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Client-side cap, requests per minute, per process (assumed conservative; not measured).
NVIDIA_RPM_LIMIT=30
NVIDIA_REASONING_EFFORT=low
NVIDIA_MAX_TOKENS=4096
NVIDIA_TEMPERATURE=0.6
NVIDIA_TIMEOUT_SECONDS=240

# --- Fallback LLM provider: OpenRouter (enabled iff key AND OPENROUTER_MODELS are set) ---
# Set to enable the OpenRouter fallback (leave empty to disable).
OPENROUTER_API_KEY=
# Ordered, comma-separated, pinned free models. Never use the random router "openrouter/free".
# Only the first entry was verified in the bake-off (see docs/model-selection.md);
# the other two are unverified, lower-confidence alternates.
OPENROUTER_MODELS=nvidia/nemotron-3.5-super-vl:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_DAILY_BUDGET=45
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_RPM_LIMIT=20
OPENROUTER_TIMEOUT_SECONDS=45

# --- Evaluation engine ---
EVAL_MAX_WORKERS=8
EVAL_MAX_ATTEMPTS=5
EVAL_BATCH_LIMIT=300
LLM_BREAKER_FAILURES=3
LLM_BREAKER_COOLDOWN_SECONDS=600

TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=your_telegram_user_or_chat_id_here

SCRAPE_INTERVAL_HOURS=6
DIGEST_TIME_CET=09:00
HOURS_OLD_WINDOW=48

SCRAPER_JITTER_MIN_SECONDS=4.0
SCRAPER_JITTER_MAX_SECONDS=9.0
SCRAPER_RESULTS_PER_QUERY=10
SCRAPER_ENABLED_BOARDS=linkedin,indeed,google
# Optional, comma-separated. Uncomment and fill in to route scraping through proxies.
# SCRAPER_PROXIES=http://user:pass@host:port

# WOW: instant alert at final score >= WOW_SCORE_THRESHOLD.
# Digest: DIGEST_SCORE_THRESHOLD <= score < WOW_SCORE_THRESHOLD. Below that: dismissed.
WOW_SCORE_THRESHOLD=8.5
DIGEST_SCORE_THRESHOLD=6.5
DIGEST_MAX_ITEMS=10
